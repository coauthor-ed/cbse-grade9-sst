{
  "terms": [
    {
      "id": "accountable",
      "term": "accountable",
      "match": [
        "accountability"
      ],
      "plain": {
        "en": "must answer to someone"
      },
      "means": {
        "en": "Those elected must answer to the people for what they do."
      },
      "lesson": 1,
      "group": "concept"
    },
    {
      "id": "legitimacy",
      "term": "legitimacy",
      "plain": {
        "en": "accepted as having the right to decide"
      },
      "means": {
        "en": "People accept a government's right to decide because they chose it."
      },
      "lesson": 1,
      "group": "concept"
    },
    {
      "id": "mandate",
      "term": "mandate",
      "plain": {
        "en": "the people's permission to govern"
      },
      "means": {
        "en": "The permission that voters give at an election. It lasts for a fixed term."
      },
      "lesson": 1,
      "group": "concept"
    },
    {
      "id": "psephology",
      "term": "psephology",
      "plain": {
        "en": "the scientific study of elections"
      },
      "means": {
        "en": "The study of how people vote and how elections work. The word comes from Greek psephos, a pebble."
      },
      "roots": [
        {
          "part": "psēphos",
          "means": {
            "en": "pebble"
          }
        },
        {
          "part": "logy",
          "means": {
            "en": "systematic study"
          }
        }
      ],
      "face": {
        "art": "archaeon",
        "tone": 2
      },
      "lesson": 1,
      "group": "concept"
    },
    {
      "id": "psephos",
      "term": "psēphos",
      "match": [
        "psephos"
      ],
      "plain": {
        "en": "a pebble"
      },
      "means": {
        "en": "The Greek word for a pebble. In ancient Greece, pebbles were used for voting."
      },
      "face": {
        "art": "archaeon",
        "tone": 5
      },
      "lesson": 1,
      "group": "concept"
    },
    {
      "id": "constituency",
      "term": "constituency",
      "match": [
        "constituencies"
      ],
      "plain": {
        "en": "an area that elects one representative"
      },
      "means": {
        "en": "An area whose voters choose one representative."
      },
      "lesson": 2,
      "group": "concept"
    },
    {
      "id": "fptp",
      "term": "First Past The Post",
      "match": [
        "FPTP"
      ],
      "plain": {
        "en": "most votes wins"
      },
      "means": {
        "en": "The candidate with the most votes in a constituency wins, even with less than 50 per cent."
      },
      "lesson": 2,
      "group": "concept"
    },
    {
      "id": "plurality",
      "term": "plurality",
      "plain": {
        "en": "more votes than anyone else"
      },
      "means": {
        "en": "The most votes, even if that is less than half of all the votes."
      },
      "lesson": 2,
      "group": "concept"
    },
    {
      "id": "proportional-representation",
      "term": "proportional representation",
      "plain": {
        "en": "seats follow votes"
      },
      "means": {
        "en": "Seats are shared in proportion to the votes each party receives."
      },
      "lesson": 2,
      "group": "concept"
    },
    {
      "id": "quota",
